```
# Android build artifacts
*.apk
*.aar
*.jar
*.class

# Android build directories
build/
.gradle/
app/build/

# Android local configuration
local.properties
.settings/

# IDE files
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Gradle wrapper (keep the properties file but ignore other potential temp files)
gradle/wrapper/*.tmp

# Log files
*.log

# Temp files
*.tmp
*.temp

# Environment
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
```